{
  "expo": {
    "name": "Selena",
    "slug": "selena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EFE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selena uses your photos only for your private baseline photo, stored on this device.",
          "cameraPermission": "Selena uses the camera only for your private baseline photo, stored on this device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Selena uses the camera only to read food barcodes. Nothing is recorded or kept.",
          "recordAudioAndroid": false
        }
      ],
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "scheme": "selena",
    "backgroundColor": "#F2EFE6"
  }
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "selena-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
